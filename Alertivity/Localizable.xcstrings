    "Disk thresholds use combined read and write throughput." : {
      "comment" : "A description of the disk thresholds.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Datenträger-Schwellenwerte basieren auf dem kombinierten Lese- und Schreibdurchsatz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les seuils du disque utilisent le débit combiné de lecture et d’écriture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ディスクのしきい値には、読み書きを合計したスループットが使用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "磁盘阈值使用读取和写入的总吞吐量。"
          }
