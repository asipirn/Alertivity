    "CPU thresholds use total system processor utilization." : {
      "comment" : "A description of the CPU thresholds setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die CPU-Schwellenwerte basieren auf der gesamten Systemprozessorauslastung."
